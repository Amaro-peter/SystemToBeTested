generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// =======================================================
// ENUMS
// =======================================================

enum AuthenticationStatus {
  SUCCESS
  USER_NOT_EXISTS
  INCORRECT_PASSWORD
  RECOVER_PASSWORD
  INVALID_TOKEN
  BLOCKED
}

enum UserRole {
  ADMIN
  SUPERVISOR_DOCTOR
  INSTRUCTOR
  PATIENT
}

enum UF {
  AC
  AL
  AP
  AM
  BA
  CE
  DF
  ES
  GO
  MA
  MT
  MS
  MG
  PA
  PB
  PR
  PE
  PI
  RJ
  RN
  RS
  RO
  RR
  SC
  SP
  SE
  TO
}

enum DoctorStatus {
  ATIVO
  SUSPENSO
  CASSADO
  INATIVO
}

enum Gender {
  FEMININO
  MASCULINO
  INTERSEXO
  PREFIRO_NAO_RESPONDER
}

enum RiskLevel {
  ALTO
  MODERADO
  BAIXO
}

enum ProfessionalCategory {
  TECNICO_DE_ENFERMAGEM
  EDUCADOR_FISICO
}

enum ClinicalSessionStatus {
  AGUARDANDO_ATENDIMENTO
  REALIZANDO_AVALIACAO_PRE_TREINAMENTO
  ESTEIRA
  BICICLETA
  MUSCULACAO
  REALIZANDO_AVALIACAO_POS_TREINAMENTO
  FINALIZADO
}

enum BicycleType {
  MMS
  NORMAL
}

enum TreadmillType {
  CONTINUO
  INTERVALADO
}

enum StrengthExerciseType {
  STEP
  MAQUINA
  BANCO_ALTO
}

// =======================================================
// CORE & USERS MODELS
// =======================================================

model User {
  id       Int    @id @default(autoincrement())
  publicId String @unique @default(uuid(7)) @map("public_id")

  name         String
  email        String @unique
  cpf          String @unique
  phoneNumber  String @map("phone_number")
  passwordHash String @map("password_hash")

  role UserRole @default(PATIENT)

  token             String?   @unique
  tokenExpiresAt    DateTime? @map("token_expires_at")
  passwordChangedAt DateTime? @map("password_changed_at")

  loginAttempts Int       @default(0) @map("login_attempts")
  lastLogin     DateTime? @map("last_login")

  isActive  Boolean   @default(true) @map("is_active")
  deletedAt DateTime? @map("deleted_at")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relações (camelCase)
  supervisorDoctor        SupervisorDoctor?
  admin                   Admin?
  instructor              Instructor?
  patient                 Patient?
  authenticationAudits    AuthenticationAudit[]
  clinicalSessionVersions ClinicalSessionVersion[]

  @@index([name])
  @@index([email])
  @@index([token])
  @@index([role])
  @@index([isActive])
  @@map("users")
}

model AuthenticationAudit {
  id Int @id @default(autoincrement())

  ipAddress  String?              @map("ip_address")
  remotePort String?              @map("remote_port")
  userAgent  String?              @map("user_agent")
  origin     String?
  status     AuthenticationStatus

  userId Int?  @map("user_id")
  // ALTERADO: Restrict impede deletar usuário se houver histórico de login
  user   User? @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([userId])
  @@map("authentication_audit")
}

model Admin {
  id       Int    @id @default(autoincrement())
  publicId String @unique @default(uuid(7))

  userId Int  @unique @map("user_id")
  // ALTERADO: Restrict para garantir que admins não sumam se tiverem auditorias atreladas
  user   User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  clinicalSessionVersions ClinicalSessionVersion[]

  @@map("admins")
}

model SupervisorDoctor {
  id       Int    @id @default(autoincrement())
  publicId String @unique @default(uuid(7))

  crm          String       @map("crm") @db.VarChar(20)
  crmUf        UF           @map("crm_uf")
  status       DoctorStatus @default(ATIVO)
  dataRegistro DateTime     @default(now()) @map("data_registro")
  dataValidade DateTime?    @map("data_validade")

  userId Int  @unique @map("user_id")
  // ALTERADO: Restrict para manter histórico médico do supervisor
  user   User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  patients Patient[]

  @@unique([crm, crmUf])
  @@index([userId])
  @@index([status])
  @@map("supervisor_doctors")
}

model Instructor {
  id       Int    @id @default(autoincrement())
  publicId String @unique @default(uuid(7))

  registration String
  speciality   ProfessionalCategory @map("speciality")

  userId Int  @unique @map("user_id")
  // MANTIDO: Restrict conforme solicitado desde o início
  user   User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  executedExercises StrengthExercise[]
  logs              Log[]

  @@map("instructors")
}

model Patient {
  id       Int    @id @default(autoincrement())
  publicId String @unique @default(uuid(7))

  birthDate             DateTime  @map("birth_date") @db.Date
  medicationsInUse      String?   @map("medications_in_use")
  assistantDoctorName   String?   @map("assistant_doctor_name")
  assistantDoctorPhone  String?   @map("assistant_doctor_phone")
  healthInsuranceNumber String?   @map("health_insurance_number")
  referenceHospital     String?   @map("reference_hospital")
  emergencyContactName  String?   @map("emergency_contact_name")
  emergencyContactPhone String?   @map("emergency_contact_phone")
  healthInsuranceName   String?   @map("health_insurance")
  gender                Gender
  riskLevel             RiskLevel @map("risk_level")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at")

  deletedAt DateTime? @map("deleted_at")

  userId Int  @unique @map("user_id")
  user   User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  supervisorDoctorId Int?
  supervisorDoctor   SupervisorDoctor? @relation(fields: [supervisorDoctorId], references: [id], onDelete: SetNull)

  classId      Int?   @map("class_id")
  patientClass Class? @relation(fields: [classId], references: [id])

  visits Visit[]
  logs   Log[]

  @@index([supervisorDoctorId])
  @@index([riskLevel])
  @@map("patients")
}

// =======================================================
// CLINICAL MODELS
// =======================================================

model Class {
  id       Int    @id @default(autoincrement())
  publicId String @unique @default(uuid(7)) @map("session_id")

  dayOfWeek String @map("day_of_week")
  time      String

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at")

  patients Patient[]

  @@map("classes")
}

model Visit {
  id       Int    @id @default(autoincrement())
  publicId String @unique @default(uuid(7)) @map("visit_id")

  patientId Int     @map("patient_id")
  patient   Patient @relation(fields: [patientId], references: [id])

  checkIn      DateTime? @map("check_in") @db.Date
  checkOut     DateTime? @map("check_out") @db.Date
  sessionStart DateTime? @map("session_start") @db.Date

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Date

  clinicalSession ClinicalSession?

  @@map("visits")
}

model ClinicalSession {
  id       Int    @id @default(autoincrement())
  publicId String @unique @default(uuid(7)) @map("clinical_session_id")

  status ClinicalSessionStatus

  // Pre-vitals
  preSystolic         Float?   @map("pre_systolic")
  preDiastolic        Float?   @map("pre_diastolic")
  preHeartRate        Int?     @map("pre_heart_rate")
  preOxygenSaturation Int?     @map("pre_oxygen_saturation")
  preWeight           Decimal? @map("pre_weight") @db.Decimal(5, 2)
  preGlucemia         Int?     @map("pre_glucemia")

  // Post-vitals
  postSystolic         Float?   @map("post_systolic")
  postDiastolic        Float?   @map("post_diastolic")
  postHeartRate        Int?     @map("post_heart_rate")
  postOxygenSaturation Int?     @map("post_oxygen_saturation")
  postWeight           Decimal? @map("post_weight") @db.Decimal(5, 2)
  postGlucemia         Int?     @map("post_glucemia")

  visitId Int?   @unique @map("visit_id")
  visit   Visit? @relation(fields: [visitId], references: [id], onDelete: Cascade)

  aerobicBicycleSheet     AerobicTrainingBicycleSheet?
  aerobicTreadmillSheet   AerobicTrainingTreadmillSheet?
  strengthTrainingSheet   StrengthTrainingSheet?
  alerts                  Alert[]
  logs                    Log[]
  clinicalSessionVersions ClinicalSessionVersion[]

  @@index([status])
  @@map("clinical_sessions")
}

model Alert {
  id       Int    @id @default(autoincrement())
  publicId String @unique @default(uuid(7)) @map("alert_id")

  message String
  date    DateTime @default(now()) @db.Timestamptz(3)

  clinicalSessionId Int             @map("clinical_session_id")
  clinicalSession   ClinicalSession @relation(fields: [clinicalSessionId], references: [id], onDelete: Cascade)

  @@map("alerts")
}

model Log {
  id       Int    @id @default(autoincrement())
  publicId String @unique @default(uuid(7)) @map("log_id")

  activityBefore ClinicalSessionStatus @map("activity_before")
  activityAfter  ClinicalSessionStatus @map("activity_after")

  clinicalSessionId Int             @map("clinical_session_id")
  session           ClinicalSession @relation(fields: [clinicalSessionId], references: [id], onDelete: Cascade)

  instructorId Int        @map("instructor_id")
  instructor   Instructor @relation(fields: [instructorId], references: [id])

  patientId Int     @map("patient_id")
  patient   Patient @relation(fields: [patientId], references: [id])

  @@index([clinicalSessionId])
  @@index([instructorId])
  @@map("logs")
}

// =======================================================
// AUDIT & METADATA
// =======================================================

model ClinicalSessionVersion {
  id       Int    @id @default(autoincrement())
  publicId String @unique @default(uuid(7)) @map("version_id")

  contentBefore Json   @map("content_before")
  tableName     String @map("table_name")
  elementId     String @map("element_id")

  updatedAt DateTime @default(now()) @map("updated_at") @db.Date

  userId Int?  @map("user_id")
  // ALTERADO: Restrict. Se um usuário fez uma alteração auditada, ele não pode ser excluído.
  user   User? @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  clinicalSessionId Int             @map("session_id")
  session           ClinicalSession @relation(fields: [clinicalSessionId], references: [id], onDelete: Cascade)

  adminId Int?
  admin   Admin? @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([clinicalSessionId])
  @@index([userId])
  @@map("clinical_session_versions")
}

model ClinicalFormMetadata {
  id        Int      @id @default(autoincrement())
  publicId  String   @unique @default(uuid(7)) @map("public_id")
  formId    String   @unique @map("form_id")
  element1  String?  @map("element_1")
  element2  String?  @map("element_2")
  element3  String?  @map("element_3")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("clinical_form_metadata")
}

// =======================================================
// TRAINING SHEETS
// =======================================================

model AerobicTrainingBicycleSheet {
  id       Int    @id @default(autoincrement())
  publicId String @unique @default(uuid(7)) @map("public_id")

  distance         Int?
  speed            Int?
  systolic         Float?      @map("systolic")
  diastolic        Float?      @map("diastolic")
  effortPerception Int?        @map("effort_perception")
  peakHeartRate    Int?        @map("peak_heart_rate")
  oxygenSaturation Int?        @map("oxygen_saturation")
  type             BicycleType

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at")

  clinicalSessionId Int             @unique @map("clinical_session_id")
  session           ClinicalSession @relation(fields: [clinicalSessionId], references: [id], onDelete: Cascade)

  @@map("aerobic_training_bicycle_sheets")
}

model AerobicTrainingTreadmillSheet {
  id       Int    @id @default(autoincrement())
  publicId String @unique @default(uuid(7)) @map("public_id")

  speed            Int?
  time             Int?
  distance         Float?
  repetitions      Int?
  systolic         Float?        @map("systolic")
  diastolic        Float?        @map("diastolic")
  effortPerception Int?          @map("effort_perception")
  type             TreadmillType

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at")

  clinicalSessionId Int             @unique @map("clinical_session_id")
  session           ClinicalSession @relation(fields: [clinicalSessionId], references: [id], onDelete: Cascade)

  @@map("aerobic_training_treadmill_sheets")
}

model StrengthTrainingSheet {
  id       Int    @id @default(autoincrement())
  publicId String @unique @default(uuid(7)) @map("public_id")

  restrictions String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at")

  clinicalSessionId Int             @unique @map("clinical_session_id")
  session           ClinicalSession @relation(fields: [clinicalSessionId], references: [id], onDelete: Cascade)

  exercises StrengthExercise[]

  @@map("strength_training_sheets")
}

model StrengthExercise {
  id       Int    @id @default(autoincrement())
  publicId String @unique @default(uuid(7)) @map("public_id")

  observations String?              @map("observations")
  series       Int                  @map("series")
  repetitions  Int                  @map("repetitions")
  load         Int?                 @map("load")
  type         StrengthExerciseType

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at")

  strengthTrainingSheetId Int                   @map("strength_training_sheet_id")
  strengthTrainingSheet   StrengthTrainingSheet @relation(fields: [strengthTrainingSheetId], references: [id], onDelete: Cascade)

  instructorId Int?        @map("instructor_id")
  instructor   Instructor? @relation(fields: [instructorId], references: [id], onDelete: SetNull)

  @@index([strengthTrainingSheetId])
  @@map("strength_exercises")
}
