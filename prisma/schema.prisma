generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AuthenticationStatus {
  SUCCESS
  USER_NOT_EXISTS
  INCORRECT_PASSWORD
  RECOVER_PASSWORD
  INVALID_TOKEN
  BLOCKED
}

enum UserRole {
  ADMIN
  SUPERVISOR_DOCTOR
  HEALTH_PROFESSIONAL
  PATIENT
}

model AuthenticationAudit {
  id         String               @id @default(uuid(7))
  ipAddress  String?              @map("ip_address")
  remotePort String?              @map("remote_port")
  userAgent  String?              @map("user_agent")
  origin     String?
  status     AuthenticationStatus
  userId     Int?                 @map("user_id")
  user       User?                @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt], name: "idx_auth_audit_user_date")
  @@map("authentication_audit")
}

model User {
  id       Int    @id @default(autoincrement())
  publicId String @unique @default(uuid(7)) @map("public_id")

  name         String
  email        String @unique
  cpf          String @unique
  phoneNumber  String @map("phone_number")
  passwordHash String @map("password_hash")

  role UserRole @default(PATIENT)

  token          String?   @unique
  tokenExpiresAt DateTime? @map("token_expires_at")
  loginAttempts  Int       @default(0) @map("login_attempts")
  lastLogin      DateTime? @map("last_login")

  isActive  Boolean   @default(true) @map("is_active")
  deletedAt DateTime? @map("deleted_at")

  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  passwordChangedAt DateTime? @map("password_changed_at")

  authenticationAudits AuthenticationAudit[]

  SupervisorDoctor SupervisorDoctor[]

  @@index([name])
  @@index([token])
  @@index([isActive])
  @@map("users")
}

model SupervisorDoctor {
  id Int @id @default(autoincrement())

  crm String @unique

  userId Int  @unique @map("user_id")
  user   User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  isActive  Boolean   @default(true) @map("is_active")
  deletedAt DateTime? @map("deleted_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([isActive])
  @@map("supervisor_doctors")
}
