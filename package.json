{
  "name": "backend-sistema-mex",
  "version": "1.0.0",
  "main": "index.js",
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "scripts": {
    "build": "tsup src --minify",
    "start:dev": "tsx watch --env-file=.env --no-deprecation src/server.ts",
    "start:prod": "node --env-file=.env dist/server.js",
    "format": "prettier --config .prettierrc.json --ignore-path .prettierignore --write 'src/**/*.{js,ts,tsx,jsx}'",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "lint:imports": "eslint \"src/**/*.{ts,js}\" --rule \"import/no-unresolved:error\" --format unix",
    "lint:imports:files": "npm run -s lint:imports 2>&1 | grep \"Unable to resolve path to module\" | cut -d: -f1 | sort -u || true",
    "lint:fix:track-imports": "npm run lint:fix && npm run -s lint:imports:files",
    "db:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:dev:default": "prisma migrate dev --name creating_database_models",
    "db:migrate:reset": "prisma migrate reset --force",
    "db:seed": "prisma db seed",
    "db:reset": "run-s db:generate db:migrate:reset db:seed",
    "db:migrate-deploy": "prisma migrate deploy",
    "db:deploy": "run-s db:migrate-deploy db:generate db:seed",
    "ci:generate": "run-p db:generate",
    "ci:lint": "run-p check:prisma:biome check:src:biome",
    "ci:format": "run-p check:prisma:biome check:src:biome",
    "ci:build": "run-s ci:generate build:tsgo build:tsup",
    "sentry:upload": "sentry-cli sourcemaps inject ./dist && sentry-cli sourcemaps upload ./dist"
  },
  "dependencies": {
    "@fastify/cors": "11.2.0",
    "@fastify/jwt": "10.0.0",
    "@fastify/rate-limit": "10.3.0",
    "@prisma/adapter-pg": "7.4.2",
    "@prisma/client": "7.4.2",
    "@sentry/node": "10.27.0",
    "@sentry/profiling-node": "10.27.0",
    "@typescript/native-preview": "7.0.0-dev.20260216.1",
    "bcryptjs": "3.0.2",
    "cpf-cnpj-validator": "1.0.3",
    "dotenv": "17.2.3",
    "fastify": "5.8.2",
    "jsonwebtoken": "9.0.3",
    "libphonenumber-js": "1.12.36",
    "ms": "2.1.3",
    "nodemailer": "7.0.11",
    "pg": "8.20.0",
    "pino": "10.1.0",
    "uuid": "11.1.0",
    "zod": "4.3.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.0",
    "@commitlint/config-conventional": "20.3.1",
    "@commitlint/types": "20.4.3",
    "@eslint/js": "9.35.0",
    "@sentry/cli": "3.1.0",
    "@swc/core": "1.15.11",
    "@types/ms": "2.1.0",
    "@types/node": "25.2.3",
    "@types/nodemailer": "7.0.4",
    "@types/pg": "8.18.0",
    "@types/supertest": "6.0.3",
    "@vitest/coverage-v8": "4.0.18",
    "commitlint": "20.4.1",
    "eslint": "9.39.2",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.4",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-prettier": "5.5.4",
    "eslint-plugin-unicorn": "63.0.0",
    "husky": "9.1.7",
    "npm-run-all": "4.1.5",
    "pino-pretty": "13.1.1",
    "prettier": "3.6.2",
    "prisma": "7.4.2",
    "ts-jest": "29.4.4",
    "ts-node": "10.9.2",
    "tsup": "8.5.0",
    "tsx": "4.20.6",
    "typescript": "5.9.2",
    "typescript-eslint": "8.56.1",
    "vite": "7.3.1",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "4.0.18"
  }
}
